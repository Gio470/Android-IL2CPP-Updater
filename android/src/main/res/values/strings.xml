    <string name="browser_place_storage">Storage</string>
    <string name="browser_place_download">Downloads</string>
    <string name="browser_place_documents">Documents</string>
    <string name="browser_place_dumpdroid">DumpDroid</string>
    <string name="browser_empty">Folder is empty</string>
