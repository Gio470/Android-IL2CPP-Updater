    <string name="filter_chip">%1$s  %2$d</string>
    <string name="result_not_found">Not Found</string>
    <string name="result_error">Error</string>
    <plurals name="result_matches">
        <item quantity="one">%1$d match</item>
        <item quantity="other">%1$d matches</item>
    </plurals>
    <!-- Confirmed after tapping a result, and the label a screen reader reads on the button. -->
    <string name="copied">Copied %1$s</string>
    <string name="copy_offset">Copy %1$s</string>
    <string name="show_candidates">View candidates</string>
    <string name="hide_candidates">Hide candidates</string>

