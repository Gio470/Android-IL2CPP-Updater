    <string name="capstone_loads">The bundled Capstone engine initialized successfully.</string>
    <string name="capstone_fails">Failed to initialize the Capstone engine: %1$s</string>
    <string name="capstone_caused_by">\n  Caused by: </string>
    <!-- %1$s the chain of failures, %2$s whether Capstone loads on its own. -->
    <string name="capstone_report">%1$s\n\n%2$s</string>

    <string name="setup_heading">Set up an update</string>
    <string name="setup_description">Prepare your files, choose an engine, then tap Start.</string>
