    <string name="access_allow">Grant Access</string>
    <string name="access_use_picker">Use System Picker</string>

    <!-- ============================================================ what can go wrong -->
    <string name="error_no_offsets">Could not parse offsets. Ensure format is one hexadecimal address (0x…) per line.</string>
    <string name="error_out_of_memory">Insufficient memory to process binary libraries. Please close background apps and retry.</string>
    <string name="message_stopped">Operation cancelled.</string>
    <!-- %1$d the line number, %2$s what was on it, %3$s what is wrong with it. -->
    <string name="warning_line">Line %1$d: \'%2$s\' %3$s</string>
    <string name="warning_dump_empty">%1$s contains no ScriptMethod entries and was skipped</string>
    <string name="error_cannot_open">Unable to open %1$s</string>
    <string name="error_nothing_to_read">No readable content found in %1$s</string>
