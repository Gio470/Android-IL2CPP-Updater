    <string name="browser_title">Choose a file</string>
    <string name="browser_close">Close</string>
    <string name="browser_up">Parent Folder</string>
    <string name="browser_system_picker">System Picker</string>
    <string name="browser_all_files">All Files</string>
    <string name="browser_showing_all">Displaying all files</string>
