<?xml version="1.0" encoding="utf-8"?>
<!--
  Every word the app shows. Nothing user-visible is written in the Kotlin, so this file is the
  only place to change wording, and the only file a translation needs.

  Placeholders: %1$s is a string, %1$d a whole number, %1$.1f a number to one decimal. Where a
  string has more than one, they are numbered and may be reordered freely. A <plurals> entry picks
  its line by the count, so keep both.
-->
<resources>

    <!-- ============================================================ the app itself -->
    <string name="app_name">IL2CPP Offset Updater</string>
    <string name="section_results">Your offsets</string>
    <string name="results_filter_empty">No offsets in this filter yet.</string>

    <!-- ============================================================ status line and card -->
    <!-- Shown before anything has been run. -->
    <string name="status_ready">Ready to Analyze</string>
    <string name="status_ready_detail">Select your original and target libraries along with your offsets, then tap Start.</string>
    <!-- %1$d offsets done, %2$s the total (an em dash until the count is known). -->
    <string name="status_working">Processing %1$d of %2$s</string>
    <string name="status_working_detail">Keep the app open while analysis is in progress.</string>
    <!-- %1$d resolved, %2$d in total. -->
    <string name="status_done">%1$d of %2$d offsets updated</string>
    <!-- %1$.1f seconds, %2$s the engine's name. -->
    <string name="status_done_detail">Completed in %1$.1fs using the %2$s engine</string>
    <string name="status_total_unknown">…</string>

    <!-- ============================================================ the toolbar -->
    <string name="pane_setup">Setup</string>
    <string name="pane_results">Results</string>
    <string name="action_start">Start</string>
    <string name="action_stop">Stop</string>
    <string name="action_copy">Copy</string>
    <string name="action_share">Share</string>
    <string name="action_clear_file">Clear %1$s</string>
    <string name="share_chooser">Share Results</string>

    <!-- ============================================================ section headers -->
    <string name="section_engine">Analysis</string>
    <string name="section_options">Advanced settings</string>
    <!-- On the right of the Files header: everything chosen, or how far along. -->
    <string name="files_ready">Ready</string>
    <string name="files_chosen">%1$d of 3 selected</string>

    <!-- ============================================================ the files -->
    <string name="file_old_library">Original Library</string>
    <string name="file_old_library_hint">The build your offsets came from</string>
    <string name="file_new_library">Target Library</string>
    <string name="file_new_library_hint">The updated library to search</string>
    <string name="file_offsets">Offsets File</string>
    <string name="file_offsets_hint">Hexadecimal offsets (0x… per line)</string>
    <string name="file_old_dump">Original Metadata Dump</string>
    <string name="file_old_dump_hint">Optional script.json from Il2CppDumper</string>
    <string name="file_new_dump">Target Metadata Dump</string>
    <string name="file_new_dump_hint">Optional metadata file to confirm ambiguous moves</string>
    <!-- Shown on the offsets row when offsets were typed rather than picked. -->
    <plurals name="file_offsets_typed">
        <item quantity="one">%1$d offset entered manually</item>
        <item quantity="other">%1$d offsets entered manually</item>
    </plurals>
    <!-- A chosen file: %1$s its name, %2$s its size. -->
    <string name="file_description">%1$s  ·  %2$s</string>
    <string name="size_megabytes">%1$d MB</string>
    <string name="size_kilobytes">%1$d KB</string>
    <string name="size_bytes">%1$d B</string>

    <!-- ============================================================ typed offsets -->
    <string name="typed_offsets_label">Manual Offsets</string>
    <string name="typed_offsets_placeholder">0x2209c04\n0x3ea393c</string>

    <!-- ============================================================ the engines -->
    <string name="engine_classic">Standard</string>
    <string name="engine_classic_blurb">Finds unique byte patterns and adjusts their length automatically.</string>
    <string name="engine_modern">Enhanced</string>
    <string name="engine_modern_blurb">Uses byte patterns, call graphs, and method tables for harder matches.</string>
    <string name="engine_nullupdater">Basic</string>
    <string name="engine_nullupdater_blurb">Matches complete functions from their entry point to the return instruction.</string>

    <!-- ============================================================ options -->
    <string name="option_auto_tune">Dynamic Length Tuning</string>
    <string name="option_start_at">Initial Length</string>
    <string name="option_widen_to">Maximum Width</string>
