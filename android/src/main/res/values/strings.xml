    <string name="options_summary">%1$s  ·  %2$s</string>
    <string name="tuning_auto">Auto, up to %1$s bytes</string>
    <string name="tuning_fixed">Fixed at %1$s bytes</string>
    <string name="tuning_grow">Expand to %1$s bytes</string>
    <plurals name="tuning_matches">
        <item quantity="one">Up to %1$s match</item>
        <item quantity="other">Up to %1$s matches</item>
    </plurals>

    <!-- ============================================================ output formats -->
    <string name="format_detailed_blurb">Comprehensive breakdown displaying all pattern signatures and matched candidates.</string>
    <string name="format_pairs_blurb">Direct mappings formatted as Old → New (one per line).</string>
    <string name="format_offsets_blurb">Clean offset list ready to be used as input for future runs.</string>

    <!-- ============================================================ results -->
    <string name="stat_resolved">Resolved</string>
